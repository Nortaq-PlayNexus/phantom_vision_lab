__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
venv/
data/experiments/
*.exe
dist/
build/
*.spec

# --- Python build / test artefacts already ignored above, plus: -------------
.coverage
htmlcov/
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- experiment output ------------------------------------------------------
# data/experiments/ is already ignored above; keep the parent explicit so an
# empty parent does not get committed by accident.
data/

# --- secrets ----------------------------------------------------------------
.env
*.key
*.pem
credentials.json

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Zenodo upload artefacts -------------------------------------------------
# Rebuildable byte-for-byte with
#   python tools/build_zenodo_package.py --out <path> --verify
# The canonical copy lives on Zenodo; the digest is recorded in
# zenodo/DEPOSIT.md. Carrying it in git history would be permanent and redundant.
zenodo/*.zip
zenodo/.zenodo_token
